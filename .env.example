# ──────────────────────────────────────────────────────────────────────────────
# Template de configuration — copier en .env et remplir avant de déployer.
# Ne jamais committer .env (il est dans .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_PIN_ENABLED=true

# Générer une valeur forte : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ou : openssl rand -hex 64
JWT_SECRET=CHANGER_CETTE_VALEUR

# PIN d'accès à l'interface admin
DEFAULT_PIN=CHOISIR_UN_PIN_A_4_CHIFFRES

# ── Serveur ───────────────────────────────────────────────────────────────────
BACKEND_PORT=4005

# URL publique de l'app — utilisée pour générer les liens d'invitation
APP_URL=https://educmentor.lionelcaro.fr

# Token de bootstrap admin — permet à Lionel de poser son cookie d'accès depuis n'importe quel appareil.
# Générer via : openssl rand -hex 32
# Bookmarquer : https://educmentor.lionelcaro.fr/admin-access?token=VALEUR
# Réutilisable à volonté — ne JAMAIS partager ni committer.
ADMIN_BOOTSTRAP_TOKEN=GENERER_VIA_openssl_rand_-hex_32

# ── Chemins ───────────────────────────────────────────────────────────────────
# En Docker : chemins absolus correspondant aux points de montage du volume app_data.
# En dev local sans Docker : chemins relatifs (./data/...) suffisent.
DB_PATH=/app/data/educmentor.db
IMAGES_PATH=/app/data/images
STATIC_PATH=/app/static
